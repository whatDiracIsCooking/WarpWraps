// hipblas.cppm - Compile-time tests for gpumod.hip.hipblas

module;

#include "test/shared/link_check.h"

export module gpumod.test.hip.hipblas;

import std;
import gpumod.hip.hipblas;

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Compile-time tests for gpumod.hip.hipblas
//
// WWR_LINK_CHECK covers all 1191 HIPBLAS_EXPORT functions declared by
// hipblas/hipblas.h -- extracted directly from the header, not hand-copied,
// so the count is exhaustive and self-verifying (a name missing from either
// the module or this file fails to compile).
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

namespace wwr::hip::test {

using namespace wwr::hip;

// ────────────────────────────────────────────────────────────────────────
// Enum type checks
// ────────────────────────────────────────────────────────────────────────

static_assert(std::is_enum_v<hipblasStatus_t>);
static_assert(std::is_enum_v<hipblasOperation_t>);
static_assert(std::is_enum_v<hipblasComputeType_t>);
static_assert(std::is_enum_v<hipblasPointerMode_t>);
static_assert(std::is_enum_v<hipblasFillMode_t>);
static_assert(std::is_enum_v<hipblasDiagType_t>);
static_assert(std::is_enum_v<hipblasSideMode_t>);
static_assert(std::is_enum_v<hipblasMath_t>);
static_assert(std::is_enum_v<hipblasGemmAlgo_t>);
static_assert(std::is_enum_v<hipblasAtomicsMode_t>);
static_assert(std::is_enum_v<hipblasGemmFlags_t>);

// ────────────────────────────────────────────────────────────────────────
// Enum values: hipblasStatus_t (from hipblas-common.h)
// ────────────────────────────────────────────────────────────────────────

static_assert(static_cast<int>(HIPBLAS_STATUS_SUCCESS) == 0);
static_assert(static_cast<int>(HIPBLAS_STATUS_NOT_INITIALIZED) == 1);
static_assert(static_cast<int>(HIPBLAS_STATUS_ALLOC_FAILED) == 2);
static_assert(static_cast<int>(HIPBLAS_STATUS_INVALID_VALUE) == 3);
static_assert(static_cast<int>(HIPBLAS_STATUS_MAPPING_ERROR) == 4);
static_assert(static_cast<int>(HIPBLAS_STATUS_EXECUTION_FAILED) == 5);
static_assert(static_cast<int>(HIPBLAS_STATUS_INTERNAL_ERROR) == 6);
static_assert(static_cast<int>(HIPBLAS_STATUS_NOT_SUPPORTED) == 7);
static_assert(static_cast<int>(HIPBLAS_STATUS_ARCH_MISMATCH) == 8);
static_assert(static_cast<int>(HIPBLAS_STATUS_HANDLE_IS_NULLPTR) == 9);
static_assert(static_cast<int>(HIPBLAS_STATUS_INVALID_ENUM) == 10);
static_assert(static_cast<int>(HIPBLAS_STATUS_UNKNOWN) == 11);

// ────────────────────────────────────────────────────────────────────────
// Enum values: hipblasOperation_t (from hipblas-common.h)
// ────────────────────────────────────────────────────────────────────────

static_assert(static_cast<int>(HIPBLAS_OP_N) == 111);
static_assert(static_cast<int>(HIPBLAS_OP_T) == 112);
static_assert(static_cast<int>(HIPBLAS_OP_C) == 113);

// ────────────────────────────────────────────────────────────────────────
// Enum values: hipblasComputeType_t (from hipblas-common.h)
// ────────────────────────────────────────────────────────────────────────

static_assert(static_cast<int>(HIPBLAS_COMPUTE_16F) == 0);
static_assert(static_cast<int>(HIPBLAS_COMPUTE_16F_PEDANTIC) == 1);
static_assert(static_cast<int>(HIPBLAS_COMPUTE_32F) == 2);
static_assert(static_cast<int>(HIPBLAS_COMPUTE_32F_PEDANTIC) == 3);
static_assert(static_cast<int>(HIPBLAS_COMPUTE_32F_FAST_16F) == 4);
static_assert(static_cast<int>(HIPBLAS_COMPUTE_32F_FAST_16BF) == 5);
static_assert(static_cast<int>(HIPBLAS_COMPUTE_32F_FAST_TF32) == 6);
static_assert(static_cast<int>(HIPBLAS_COMPUTE_64F) == 7);
static_assert(static_cast<int>(HIPBLAS_COMPUTE_64F_PEDANTIC) == 8);
static_assert(static_cast<int>(HIPBLAS_COMPUTE_32I) == 9);
static_assert(static_cast<int>(HIPBLAS_COMPUTE_32I_PEDANTIC) == 10);
static_assert(static_cast<int>(HIPBLAS_COMPUTE_32F_FAST_8F_FNUZ) == 100);
static_assert(static_cast<int>(HIPBLAS_COMPUTE_32F_FAST_8BF_FNUZ) == 101);
static_assert(static_cast<int>(HIPBLAS_COMPUTE_32F_FAST_8F8BF_FNUZ) == 102);
static_assert(static_cast<int>(HIPBLAS_COMPUTE_32F_FAST_8BF8F_FNUZ) == 103);

// ────────────────────────────────────────────────────────────────────────
// Enum values: hipblasPointerMode_t / hipblasFillMode_t / hipblasDiagType_t /
// hipblasSideMode_t (from hipblas.h itself)
// ────────────────────────────────────────────────────────────────────────

static_assert(static_cast<int>(HIPBLAS_POINTER_MODE_HOST) == 0);
static_assert(static_cast<int>(HIPBLAS_POINTER_MODE_DEVICE) == 1);

static_assert(static_cast<int>(HIPBLAS_FILL_MODE_UPPER) == 121);
static_assert(static_cast<int>(HIPBLAS_FILL_MODE_LOWER) == 122);
static_assert(static_cast<int>(HIPBLAS_FILL_MODE_FULL) == 123);

static_assert(static_cast<int>(HIPBLAS_DIAG_NON_UNIT) == 131);
static_assert(static_cast<int>(HIPBLAS_DIAG_UNIT) == 132);

static_assert(static_cast<int>(HIPBLAS_SIDE_LEFT) == 141);
static_assert(static_cast<int>(HIPBLAS_SIDE_RIGHT) == 142);
static_assert(static_cast<int>(HIPBLAS_SIDE_BOTH) == 143);

// ────────────────────────────────────────────────────────────────────────
// Enum values: hipblasMath_t / hipblasGemmAlgo_t / hipblasAtomicsMode_t /
// hipblasGemmFlags_t
// ────────────────────────────────────────────────────────────────────────

static_assert(static_cast<int>(HIPBLAS_DEFAULT_MATH) == 0);
static_assert(static_cast<int>(HIPBLAS_XF32_XDL_MATH) == 1);
static_assert(static_cast<int>(HIPBLAS_PEDANTIC_MATH) == 2);
static_assert(static_cast<int>(HIPBLAS_TF32_TENSOR_OP_MATH) == 3);
static_assert(static_cast<int>(HIPBLAS_MATH_DISALLOW_REDUCED_PRECISION_REDUCTION) == 4);
static_assert(static_cast<int>(HIPBLAS_TENSOR_OP_MATH) == 5);

static_assert(static_cast<int>(HIPBLAS_GEMM_DEFAULT) == 160);

static_assert(static_cast<int>(HIPBLAS_ATOMICS_NOT_ALLOWED) == 0);
static_assert(static_cast<int>(HIPBLAS_ATOMICS_ALLOWED) == 1);

static_assert(static_cast<unsigned>(HIPBLAS_GEMM_FLAGS_NONE) == 0x0u);
static_assert(static_cast<unsigned>(HIPBLAS_GEMM_FLAGS_USE_CU_EFFICIENCY) == 0x2u);
static_assert(static_cast<unsigned>(HIPBLAS_GEMM_FLAGS_FP16_ALT_IMPL) == 0x4u);
static_assert(static_cast<unsigned>(HIPBLAS_GEMM_FLAGS_CHECK_SOLUTION_INDEX) == 0x8u);
static_assert(static_cast<unsigned>(HIPBLAS_GEMM_FLAGS_FP16_ALT_IMPL_RNZ) == 0x10u);

// ────────────────────────────────────────────────────────────────────────
// Handle type traits (opaque pointer type)
// ────────────────────────────────────────────────────────────────────────

static_assert(std::is_pointer_v<hipblasHandle_t>);

// ────────────────────────────────────────────────────────────────────────
// hipBLAS-specific scalar typedefs (no cuBLAS-side equivalent)
// ────────────────────────────────────────────────────────────────────────

static_assert(std::is_same_v<hipblasInt8, std::int8_t>);
static_assert(std::is_same_v<hipblasStride, std::int64_t>);

