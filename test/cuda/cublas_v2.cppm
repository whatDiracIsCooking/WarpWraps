// cublas_v2.cppm - Compile-time tests for wwr.cuda.cublas_v2

module;

#include "test/shared/link_check.h"

export module wwr.test.cuda.cublas_v2;

import std;
import wwr.cuda.cublas_v2;

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Compile-time tests for wwr.cuda.cublas_v2
//
// Link-check-focused (#117): forces the linker to resolve every re-exported
// function symbol, so a re-export the libcublas.so does not actually export fails the
// build. A symbol the header declares but the library does not define uses
// WWR_DECLARED_CHECK instead, naming the version it was found missing from.
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

namespace wwr::cuda::test {

// ────────────────────────────────────────────────────────────────────────
// Link-time symbol resolution
// ────────────────────────────────────────────────────────────────────────

