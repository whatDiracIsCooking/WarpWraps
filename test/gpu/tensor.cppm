// tensor.cppm - Compile-time tests for wwr.tensor
//
// Every exported wwrtensor* name is checked against the backend's own entity:
// the same type, the same constant (type and value), the same function (see
// gpu_check_macros.h). The whole host API is listed -- like test/gpu/rand.cppm
// and unlike blas/solver, which sample -- because there is no runtime or
// dispatch test downstream to catch a wrong-but-existing backend name (a real
// contraction needs a device job to run).
//
// Unlike test/gpu/ccl.cppm (NCCL/RCCL share identical spellings, so one block
// suffices) the two backends are checked separately: cuTENSOR and hipTensor are
// independent APIs, so the names differ (cutensor* vs hiptensor*). Enumerator
// VALUES are pinned regardless, since matching names never guarantee matching
// values (docs/architecture.md, sections 1 and 6) -- this is exactly what the
// "not a hipify pair" measurement in src/tensor.cppm rests on.
//
// wwrtensorLoggerSetLevel is a forwarding function, not an alias (cuTENSOR takes
// int32_t, hipTensor an enum), so it is not WWR_SAME_FUNCTION'd; its neutral
// signature is pinned once, for both backends, at the end.

module;

#include "gpu_check_macros.h"

export module wwr.test.gpu.tensor;

import std;
import wwr.tensor;
#if defined(WWR_GPU_BACKEND_CUDA)
import wwr.cuda.cutensor;
#else
import wwr.hip.hiptensor;
#endif

namespace wwr::test {

using namespace wwr;

#if defined(WWR_GPU_BACKEND_CUDA)

using namespace wwr::cuda;

