// Compute descriptors are extern-const opaque pointers here (runtime
// globals, not constant expressions), so WWR_SAME_VALUE's `==` cannot be
// a constant expression -- pin object identity and type instead.
static_assert(&WWRTENSOR_COMPUTE_DESC_16F == &CUTENSOR_COMPUTE_DESC_16F,
              "WWRTENSOR_COMPUTE_DESC_16F is not CUTENSOR_COMPUTE_DESC_16F");
static_assert(&WWRTENSOR_COMPUTE_DESC_16BF == &CUTENSOR_COMPUTE_DESC_16BF,
              "WWRTENSOR_COMPUTE_DESC_16BF is not CUTENSOR_COMPUTE_DESC_16BF");
static_assert(&WWRTENSOR_COMPUTE_DESC_32F == &CUTENSOR_COMPUTE_DESC_32F,
              "WWRTENSOR_COMPUTE_DESC_32F is not CUTENSOR_COMPUTE_DESC_32F");
static_assert(&WWRTENSOR_COMPUTE_DESC_64F == &CUTENSOR_COMPUTE_DESC_64F,
              "WWRTENSOR_COMPUTE_DESC_64F is not CUTENSOR_COMPUTE_DESC_64F");
WWR_SAME_TYPE(std::remove_cvref_t<decltype(WWRTENSOR_COMPUTE_DESC_32F)>,
                 cutensorComputeDescriptor_t)

