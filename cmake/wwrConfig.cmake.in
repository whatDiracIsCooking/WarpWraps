@PACKAGE_INIT@

# wwr package configuration.
#
# What this file has to do beyond including the target export set comes from one
# fact about C++23 named modules: a consumer of this package COMPILES the module
# interface sources it installs (a BMI is not portable, so none is shipped --
# cmake/wwr_install.cmake explains the mechanism). A consumer's build is
# therefore not merely linking against wwr, it is continuing it, and the
# three things checked below are the ones where continuing it with different
# settings produces a failure whose message points nowhere near the cause.

include(CMakeFindDependencyMacro)

set(WWR_GPU_BACKEND "@WWR_PACKAGE_BACKEND@")
set(WWR_WARP_SIZE "@WWR_PACKAGE_WARP_SIZE@")
# Whether this installation shipped the wrappers layer (src/wrappers). ON
# unless the build passed -DWWR_INSTALL_WRAPPERS=OFF. A bare boolean, not
# quoted -- it is tested directly below. See section 1b.
set(WWR_HAS_WRAPPERS @WWR_PACKAGE_HAS_WRAPPERS@)
# Whether this installation shipped the extension layer (src/extension), built
# with -DWWR_INSTALL_EXTENSION=ON. A bare boolean, not quoted -- it is tested
# directly below. See section 1c.
set(WWR_HAS_EXTENSION @WWR_PACKAGE_HAS_EXTENSION@)
# Whether this installation shipped the collective-communications wrapper
# (wwr.ccl / wwr.extension.ccl), built with -DWWR_WITH_CCL=ON (the default). A
# bare boolean -- tested directly below. See section 1d and section 3.
# comp/tensor get WWR_HAS_COMP / WWR_HAS_TENSOR the same way.
set(WWR_HAS_CCL @WWR_PACKAGE_HAS_CCL@)
# Whether this installation shipped the compression wrapper (wwr.comp /
# wwr.extension.comp), built with -DWWR_WITH_COMP=ON (the default). See section
# 1e and section 3.
set(WWR_HAS_COMP @WWR_PACKAGE_HAS_COMP@)
# Whether this installation shipped the tensor-contraction wrapper (wwr.tensor /
# wwr.extension.tensor), built with -DWWR_WITH_TENSOR=ON (the default). See
# section 1f and section 3.
set(WWR_HAS_TENSOR @WWR_PACKAGE_HAS_TENSOR@)
set(WWR_BUILT_WITH_CXX_COMPILER_ID "@WWR_PACKAGE_CXX_COMPILER_ID@")
set(WWR_BUILT_WITH_CXX_COMPILER_VERSION
    "@WWR_PACKAGE_CXX_COMPILER_VERSION@"
)
set(WWR_BUILT_WITH_CXX_STANDARD_LIBRARY
    "@WWR_PACKAGE_CXX_STANDARD_LIBRARY@"
)

# ---------------------------------------------------------------------------
# 1. Backend
# ---------------------------------------------------------------------------
# An installation is built against exactly one backend and contains only that
# backend's wrapper modules. Asking for the other one is not a thing that can
# half-work, so it is refused here rather than at the point where
# `import wwr.cuda.cublas_v2;` fails to resolve in a HIP install.
if(DEFINED wwr_FIND_COMPONENTS)
  foreach(_wwr_component IN LISTS wwr_FIND_COMPONENTS)
    if(_wwr_component MATCHES "^(CUDA|HIP)$"
       AND NOT _wwr_component STREQUAL WWR_GPU_BACKEND
    )
      set(wwr_FOUND FALSE)
      set(wwr_NOT_FOUND_MESSAGE
          "This wwr installation was built for the ${WWR_GPU_BACKEND} "
          "backend; the ${_wwr_component} component was requested. A build "
          "targets exactly one backend -- install a ${_wwr_component} build "
          "of wwr to a separate prefix."
      )
      return()
    endif()
  endforeach()
  unset(_wwr_component)
endif()

# ---------------------------------------------------------------------------
# 1b. Wrappers component
# ---------------------------------------------------------------------------
# The wrappers layer ships unless the build passed -DWWR_INSTALL_WRAPPERS=OFF.
# Exposed as the `wrappers` component so `find_package(wwr COMPONENTS wrappers)`
# is refused here, naming the cause, rather than later when
# `import wwr.wrappers.blas;` fails to resolve against a core-only install.
# wwr_wrappers_FOUND is set either way, so the check_required_components() at the
# end of this file agrees with this verdict.
set(wwr_wrappers_FOUND ${WWR_HAS_WRAPPERS})
if(wwr_FIND_REQUIRED_wrappers AND NOT WWR_HAS_WRAPPERS)
  set(wwr_FOUND FALSE)
  # One string argument, not several: set() with multiple quoted arguments builds
  # a list and find_package prints the ';' separators between them.
  set(wwr_NOT_FOUND_MESSAGE
      "This wwr installation was built without the wrappers layer, but the 'wrappers' component was requested. Reinstall the package with -DWWR_INSTALL_WRAPPERS=ON (the default)."
  )
  return()
endif()

# ---------------------------------------------------------------------------
# 1c. Extension component
# ---------------------------------------------------------------------------
# The extension layer ships only from a build configured with
# -DWWR_INSTALL_EXTENSION=ON. Exposed as the `extension` component so
# `find_package(wwr COMPONENTS extension)` is refused here, naming the cause,
# rather than later when `import wwr.extension.runtime;` fails to resolve against
# a core-only install. wwr_extension_FOUND is set either way, so the
# check_required_components() at the end of this file agrees with this verdict.
set(wwr_extension_FOUND ${WWR_HAS_EXTENSION})
if(wwr_FIND_REQUIRED_extension AND NOT WWR_HAS_EXTENSION)
  set(wwr_FOUND FALSE)
  # One string argument, not several: set() with multiple quoted arguments builds
  # a list and find_package prints the ';' separators between them.
  set(wwr_NOT_FOUND_MESSAGE
      "This wwr installation was built without the extension layer, but the 'extension' component was requested. Reinstall the package with -DWWR_INSTALL_EXTENSION=ON."
  )
  return()
endif()

# ---------------------------------------------------------------------------
# 1d. Collective-communications component
# ---------------------------------------------------------------------------
# The ccl wrapper (wwr.ccl and wwr.extension.ccl, backed by NCCL or RCCL) ships
# only from a build configured with -DWWR_WITH_CCL=ON (the default). Exposed as
# the `ccl` component so `find_package(wwr COMPONENTS ccl)` is refused here,
# naming the cause, rather than later when `import wwr.ccl;` fails to resolve
# against a build that disabled it. wwr_ccl_FOUND is set either way, so the
# check_required_components() at the end of this file agrees with this verdict.
set(wwr_ccl_FOUND ${WWR_HAS_CCL})
if(wwr_FIND_REQUIRED_ccl AND NOT WWR_HAS_CCL)
  set(wwr_FOUND FALSE)
  # One string argument, not several: set() with multiple quoted arguments builds
  # a list and find_package prints the ';' separators between them.
  set(wwr_NOT_FOUND_MESSAGE
      "This wwr installation was built without the collective-communications wrapper, but the 'ccl' component was requested. Reinstall the package with -DWWR_WITH_CCL=ON (the default)."
  )
  return()
endif()

# ---------------------------------------------------------------------------
# 1e. Compression component
# ---------------------------------------------------------------------------
# The comp wrapper (wwr.comp and wwr.extension.comp, backed by nvCOMP or
# hipCOMP) ships only from a build configured with -DWWR_WITH_COMP=ON (the
# default). Exposed as the `comp` component, same as `ccl` above.
set(wwr_comp_FOUND ${WWR_HAS_COMP})
if(wwr_FIND_REQUIRED_comp AND NOT WWR_HAS_COMP)
  set(wwr_FOUND FALSE)
  set(wwr_NOT_FOUND_MESSAGE
      "This wwr installation was built without the compression wrapper, but the 'comp' component was requested. Reinstall the package with -DWWR_WITH_COMP=ON (the default)."
  )
  return()
endif()

# ---------------------------------------------------------------------------
# 1f. Tensor-contraction component
# ---------------------------------------------------------------------------
# The tensor wrapper (wwr.tensor and wwr.extension.tensor, backed by cuTENSOR or
# hipTensor) ships only from a build configured with -DWWR_WITH_TENSOR=ON (the
# default). Exposed as the `tensor` component, same as `ccl` above.
set(wwr_tensor_FOUND ${WWR_HAS_TENSOR})
if(wwr_FIND_REQUIRED_tensor AND NOT WWR_HAS_TENSOR)
  set(wwr_FOUND FALSE)
  set(wwr_NOT_FOUND_MESSAGE
      "This wwr installation was built without the tensor-contraction wrapper, but the 'tensor' component was requested. Reinstall the package with -DWWR_WITH_TENSOR=ON (the default)."
  )
  return()
endif()

# ---------------------------------------------------------------------------
# 2. Toolchain
# ---------------------------------------------------------------------------
# The consumer compiles this package's module interface units with the
# consumer's own compiler. Module interface sources are not portable across
# implementations, and this project's units are clang + libc++ specific (they
# `import std`, which needs libc++'s module manifest). A mismatch here surfaces
# as a wall of errors inside wwr's own sources, which reads as wwr being
# broken rather than as the build using the wrong compiler -- hence a warning
# that names the cause.
#
# A warning and not an error: matching the compiler EXACTLY is stricter than
# necessary in practice, and a consumer who knows their toolchain is compatible
# should not need to patch this file. Silence it with
# -DWWR_SKIP_TOOLCHAIN_CHECK=ON.
if(NOT WWR_SKIP_TOOLCHAIN_CHECK)
  if(NOT CMAKE_CXX_COMPILER_ID STREQUAL WWR_BUILT_WITH_CXX_COMPILER_ID)
    message(
      WARNING
        "wwr was built with ${WWR_BUILT_WITH_CXX_COMPILER_ID}, this "
        "project uses ${CMAKE_CXX_COMPILER_ID}. Consumers COMPILE wwr's "
        "module interface units, and this project's units require Clang -- "
        "expect errors inside wwr's own sources."
    )
  elseif(NOT CMAKE_CXX_COMPILER_VERSION VERSION_EQUAL
         WWR_BUILT_WITH_CXX_COMPILER_VERSION
  )
    message(
      STATUS
        "wwr was built with Clang "
        "${WWR_BUILT_WITH_CXX_COMPILER_VERSION}, this project uses "
        "${CMAKE_CXX_COMPILER_VERSION}. Module sources are recompiled by the "
        "consumer, so this is usually fine."
    )
  endif()

  if(WWR_BUILT_WITH_CXX_STANDARD_LIBRARY
     AND NOT CMAKE_CXX_STANDARD_LIBRARY STREQUAL
         WWR_BUILT_WITH_CXX_STANDARD_LIBRARY
  )
    message(
      WARNING
        "wwr was built against ${WWR_BUILT_WITH_CXX_STANDARD_LIBRARY}, "
        "this project uses '${CMAKE_CXX_STANDARD_LIBRARY}'. `import std` "
        "resolves against the standard library's own module manifest; set "
        "CMAKE_CXX_STANDARD_LIBRARY to "
        "${WWR_BUILT_WITH_CXX_STANDARD_LIBRARY} before project()."
    )
  endif()
endif()

# ---------------------------------------------------------------------------
# 3. Backend packages
# ---------------------------------------------------------------------------
# The vendor imported targets (CUDA::cublas, hip::host, ...) appear in this
# package's INTERFACE_LINK_LIBRARIES, so they have to exist before the export
# set is included.
if(WWR_GPU_BACKEND STREQUAL "CUDA")
  find_dependency(CUDAToolkit)

  # libcusolverMg is not a FindCUDAToolkit component -- there is no
  # CUDA::cusolverMg target -- so src/cuda/CMakeLists.txt finds it by hand and
  # links it through an imported target. Exporting an imported target writes
  # its NAME into the export set and nothing else, so the name has to be
  # recreated here. Re-finding rather than baking in the build machine's
  # absolute path is what keeps the installed package relocatable.
  if(NOT TARGET wwr::cuda_cusolverMg)
    find_library(
      WWR_cusolverMg_LIBRARY
      NAMES cusolverMg
      HINTS ${CUDAToolkit_LIBRARY_DIR}
    )
    if(NOT WWR_cusolverMg_LIBRARY)
      set(wwr_FOUND FALSE)
      set(wwr_NOT_FOUND_MESSAGE
          "libcusolverMg not found. It ships with the CUDA Toolkit but is not "
          "a FindCUDAToolkit component; pass -DWWR_cusolverMg_LIBRARY=<path>"
          " if it lives outside ${CUDAToolkit_LIBRARY_DIR}."
      )
      return()
    endif()
    add_library(wwr::cuda_cusolverMg UNKNOWN IMPORTED)
    set_target_properties(
      wwr::cuda_cusolverMg PROPERTIES IMPORTED_LOCATION
                                         "${WWR_cusolverMg_LIBRARY}"
    )
  endif()

  # libnccl is likewise not a FindCUDAToolkit component (no CUDA::nccl target) --
  # src/cuda/CMakeLists.txt finds it by hand and links it through the imported
  # target wwr::cuda_nccl, so the name is recreated here, same as cusolverMg.
  # Guarded on WWR_HAS_CCL: a package built with -DWWR_WITH_CCL=OFF ships no
  # wwr.cuda.nccl, so re-finding libnccl would demand a library the consumer was
  # promised they would not need.
  if(WWR_HAS_CCL AND NOT TARGET wwr::cuda_nccl)
    find_library(WWR_nccl_LIBRARY NAMES nccl HINTS ${CUDAToolkit_LIBRARY_DIR})
    if(NOT WWR_nccl_LIBRARY)
      set(wwr_FOUND FALSE)
      set(wwr_NOT_FOUND_MESSAGE
          "libnccl not found. NCCL is not part of the CUDA Toolkit; install "
          "libnccl-dev, or pass -DWWR_nccl_LIBRARY=<path>."
      )
      return()
    endif()
    add_library(wwr::cuda_nccl UNKNOWN IMPORTED)
    set_target_properties(
      wwr::cuda_nccl PROPERTIES IMPORTED_LOCATION "${WWR_nccl_LIBRARY}"
    )
  endif()

  # nvCOMP is not a FindCUDAToolkit component either, but unlike nccl it ships
  # its own CMake config package providing nvcomp::nvcomp, which wwr.cuda.nvcomp
  # links -- so re-find it the ordinary way. Guarded on WWR_HAS_COMP: a package
  # built with -DWWR_WITH_COMP=OFF ships no wwr.cuda.nvcomp and must not demand it.
  if(WWR_HAS_COMP)
    find_dependency(nvcomp)
  endif()

  # cuTENSOR ships no CMake config package and is not a FindCUDAToolkit
  # component, so src/cuda/CMakeLists.txt finds its header and library by hand
  # and links them through the imported target wwr::cuda_cutensor, recreated
  # here from CMAKE_PREFIX_PATH (docker/install-cuda.sh puts /opt/nvidia/cutensor
  # there). Unlike nccl, the header is off any default path, so the include dir
  # is part of the target too. Guarded on WWR_HAS_TENSOR, same as the ccl blocks.
  if(WWR_HAS_TENSOR AND NOT TARGET wwr::cuda_cutensor)
    find_path(WWR_cutensor_INCLUDE_DIR cutensor.h)
    find_library(WWR_cutensor_LIBRARY NAMES cutensor)
    if(NOT WWR_cutensor_INCLUDE_DIR OR NOT WWR_cutensor_LIBRARY)
      set(wwr_FOUND FALSE)
      set(wwr_NOT_FOUND_MESSAGE
          "cuTENSOR not found. It ships no CMake config and is not part of the "
          "CUDA Toolkit; put its prefix on CMAKE_PREFIX_PATH, or pass "
          "-DWWR_cutensor_INCLUDE_DIR=<dir> -DWWR_cutensor_LIBRARY=<path>."
      )
      return()
    endif()
    add_library(wwr::cuda_cutensor UNKNOWN IMPORTED)
    set_target_properties(
      wwr::cuda_cutensor
      PROPERTIES IMPORTED_LOCATION "${WWR_cutensor_LIBRARY}"
                 INTERFACE_INCLUDE_DIRECTORIES "${WWR_cutensor_INCLUDE_DIR}"
    )
  endif()
else()
  find_dependency(hip)
  find_dependency(amd_smi)
  find_dependency(hiprtc)
  find_dependency(hipblas)
  find_dependency(hipblaslt)
  find_dependency(hipsolver)
  find_dependency(hipsparse)
  find_dependency(hipfft)
  find_dependency(hiprand)
  # Guarded on WWR_HAS_CCL, same as the CUDA-side libnccl block above: a package
  # built with -DWWR_WITH_CCL=OFF ships no wwr.hip.rccl, so it must not demand
  # RCCL of a consumer.
  if(WWR_HAS_CCL)
    find_dependency(rccl)
  endif()
  # Guarded on WWR_HAS_COMP, same as the CUDA-side nvcomp.
  if(WWR_HAS_COMP)
    find_dependency(hipcomp)
  endif()

  # hipTensor is linked through the hand-wrapped imported target
  # wwr::hip_hiptensor (NOT hiptensor::hiptensor, whose hip::device interface
  # would force device compilation on host consumers -- see
  # src/hip/CMakeLists.txt), so the name is recreated here, same as cuTENSOR
  # above and nccl on the CUDA side. Guarded on WWR_HAS_TENSOR.
  if(WWR_HAS_TENSOR AND NOT TARGET wwr::hip_hiptensor)
    find_path(WWR_hiptensor_INCLUDE_DIR hiptensor/hiptensor.h
              HINTS ${ROCM_PATH} $ENV{ROCM_PATH} /opt/rocm PATH_SUFFIXES include)
    find_library(WWR_hiptensor_LIBRARY NAMES hiptensor
                 HINTS ${ROCM_PATH} $ENV{ROCM_PATH} /opt/rocm PATH_SUFFIXES lib)
    if(NOT WWR_hiptensor_INCLUDE_DIR OR NOT WWR_hiptensor_LIBRARY)
      set(wwr_FOUND FALSE)
      set(wwr_NOT_FOUND_MESSAGE
          "hipTensor not found. Install hiptensor-dev (part of rocm-hip-sdk), "
          "or pass -DWWR_hiptensor_INCLUDE_DIR=<dir> -DWWR_hiptensor_LIBRARY=<path>."
      )
      return()
    endif()
    add_library(wwr::hip_hiptensor UNKNOWN IMPORTED)
    set_target_properties(
      wwr::hip_hiptensor
      PROPERTIES IMPORTED_LOCATION "${WWR_hiptensor_LIBRARY}"
                 INTERFACE_INCLUDE_DIRECTORIES "${WWR_hiptensor_INCLUDE_DIR}"
    )
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/wwr-targets.cmake")

check_required_components(wwr)
