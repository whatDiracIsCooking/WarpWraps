/**
 * @file cublasLt.cppm
 * @brief Primary interface for wwr.cuda.cublasLt
 *
 * This module wraps the native cuBLASLt API and exports types, constants,
 * and functions for the cuBLASLt (lightweight cuBLAS) library.
 *
 * Usage:
 *   import wwr.cuda.cublasLt;
 */

module;

#include <cublasLt.h>

// Validate and undef numeric implementation flag macros before they
// escape into the module's purview.
static_assert(CUBLASLT_NUMERICAL_IMPL_FLAGS_FMA == (0x01ull << 0),
              "CUBLASLT_NUMERICAL_IMPL_FLAGS_FMA mismatch");
static_assert(CUBLASLT_NUMERICAL_IMPL_FLAGS_HMMA == (0x02ull << 0),
              "CUBLASLT_NUMERICAL_IMPL_FLAGS_HMMA mismatch");
static_assert(CUBLASLT_NUMERICAL_IMPL_FLAGS_IMMA == (0x04ull << 0),
              "CUBLASLT_NUMERICAL_IMPL_FLAGS_IMMA mismatch");
static_assert(CUBLASLT_NUMERICAL_IMPL_FLAGS_DMMA == (0x08ull << 0),
              "CUBLASLT_NUMERICAL_IMPL_FLAGS_DMMA mismatch");
static_assert(CUBLASLT_NUMERICAL_IMPL_FLAGS_TENSOR_OP_MASK == (0xfeull << 0),
              "CUBLASLT_NUMERICAL_IMPL_FLAGS_TENSOR_OP_MASK mismatch");
static_assert(CUBLASLT_NUMERICAL_IMPL_FLAGS_OP_TYPE_MASK == (0xffull << 0),
              "CUBLASLT_NUMERICAL_IMPL_FLAGS_OP_TYPE_MASK mismatch");

static_assert(CUBLASLT_NUMERICAL_IMPL_FLAGS_ACCUMULATOR_16F == (0x01ull << 8),
              "CUBLASLT_NUMERICAL_IMPL_FLAGS_ACCUMULATOR_16F mismatch");
static_assert(CUBLASLT_NUMERICAL_IMPL_FLAGS_ACCUMULATOR_32F == (0x02ull << 8),
              "CUBLASLT_NUMERICAL_IMPL_FLAGS_ACCUMULATOR_32F mismatch");
static_assert(CUBLASLT_NUMERICAL_IMPL_FLAGS_ACCUMULATOR_64F == (0x04ull << 8),
              "CUBLASLT_NUMERICAL_IMPL_FLAGS_ACCUMULATOR_64F mismatch");
static_assert(CUBLASLT_NUMERICAL_IMPL_FLAGS_ACCUMULATOR_32I == (0x08ull << 8),
              "CUBLASLT_NUMERICAL_IMPL_FLAGS_ACCUMULATOR_32I mismatch");
static_assert(CUBLASLT_NUMERICAL_IMPL_FLAGS_ACCUMULATOR_TYPE_MASK == (0xffull << 8),
              "CUBLASLT_NUMERICAL_IMPL_FLAGS_ACCUMULATOR_TYPE_MASK mismatch");

static_assert(CUBLASLT_NUMERICAL_IMPL_FLAGS_INPUT_16F == (0x01ull << 16),
              "CUBLASLT_NUMERICAL_IMPL_FLAGS_INPUT_16F mismatch");
static_assert(CUBLASLT_NUMERICAL_IMPL_FLAGS_INPUT_16BF == (0x02ull << 16),
              "CUBLASLT_NUMERICAL_IMPL_FLAGS_INPUT_16BF mismatch");
static_assert(CUBLASLT_NUMERICAL_IMPL_FLAGS_INPUT_TF32 == (0x04ull << 16),
              "CUBLASLT_NUMERICAL_IMPL_FLAGS_INPUT_TF32 mismatch");
static_assert(CUBLASLT_NUMERICAL_IMPL_FLAGS_INPUT_32F == (0x08ull << 16),
              "CUBLASLT_NUMERICAL_IMPL_FLAGS_INPUT_32F mismatch");
static_assert(CUBLASLT_NUMERICAL_IMPL_FLAGS_INPUT_64F == (0x10ull << 16),
              "CUBLASLT_NUMERICAL_IMPL_FLAGS_INPUT_64F mismatch");
static_assert(CUBLASLT_NUMERICAL_IMPL_FLAGS_INPUT_8I == (0x20ull << 16),
              "CUBLASLT_NUMERICAL_IMPL_FLAGS_INPUT_8I mismatch");
static_assert(CUBLASLT_NUMERICAL_IMPL_FLAGS_INPUT_8F_E4M3 == (0x40ull << 16),
              "CUBLASLT_NUMERICAL_IMPL_FLAGS_INPUT_8F_E4M3 mismatch");
static_assert(CUBLASLT_NUMERICAL_IMPL_FLAGS_INPUT_8F_E5M2 == (0x80ull << 16),
              "CUBLASLT_NUMERICAL_IMPL_FLAGS_INPUT_8F_E5M2 mismatch");
static_assert(CUBLASLT_NUMERICAL_IMPL_FLAGS_OP_INPUT_TYPE_MASK == (0xffull << 16),
              "CUBLASLT_NUMERICAL_IMPL_FLAGS_OP_INPUT_TYPE_MASK mismatch");

static_assert(CUBLASLT_NUMERICAL_IMPL_FLAGS_GAUSSIAN == (0x01ull << 32),
              "CUBLASLT_NUMERICAL_IMPL_FLAGS_GAUSSIAN mismatch");

#undef CUBLASLT_NUMERICAL_IMPL_FLAGS_FMA
#undef CUBLASLT_NUMERICAL_IMPL_FLAGS_HMMA
#undef CUBLASLT_NUMERICAL_IMPL_FLAGS_IMMA
#undef CUBLASLT_NUMERICAL_IMPL_FLAGS_DMMA
#undef CUBLASLT_NUMERICAL_IMPL_FLAGS_TENSOR_OP_MASK
#undef CUBLASLT_NUMERICAL_IMPL_FLAGS_OP_TYPE_MASK
#undef CUBLASLT_NUMERICAL_IMPL_FLAGS_ACCUMULATOR_16F
#undef CUBLASLT_NUMERICAL_IMPL_FLAGS_ACCUMULATOR_32F
#undef CUBLASLT_NUMERICAL_IMPL_FLAGS_ACCUMULATOR_64F
#undef CUBLASLT_NUMERICAL_IMPL_FLAGS_ACCUMULATOR_32I
#undef CUBLASLT_NUMERICAL_IMPL_FLAGS_ACCUMULATOR_TYPE_MASK
#undef CUBLASLT_NUMERICAL_IMPL_FLAGS_INPUT_16F
#undef CUBLASLT_NUMERICAL_IMPL_FLAGS_INPUT_16BF
#undef CUBLASLT_NUMERICAL_IMPL_FLAGS_INPUT_TF32
#undef CUBLASLT_NUMERICAL_IMPL_FLAGS_INPUT_32F
#undef CUBLASLT_NUMERICAL_IMPL_FLAGS_INPUT_64F
#undef CUBLASLT_NUMERICAL_IMPL_FLAGS_INPUT_8I
#undef CUBLASLT_NUMERICAL_IMPL_FLAGS_INPUT_8F_E4M3
#undef CUBLASLT_NUMERICAL_IMPL_FLAGS_INPUT_8F_E5M2
#undef CUBLASLT_NUMERICAL_IMPL_FLAGS_OP_INPUT_TYPE_MASK
#undef CUBLASLT_NUMERICAL_IMPL_FLAGS_GAUSSIAN

export module wwr.cuda.cublasLt;

// ========================================================================
// Export all cuBLASLt types and functions in wwr namespace
// ========================================================================

export namespace wwr::cuda {

// ========================================================================
// Numeric implementation flags (constexpr replacements for macros)
// ========================================================================

inline constexpr unsigned long long CUBLASLT_NUMERICAL_IMPL_FLAGS_FMA = (0x01ull << 0);
