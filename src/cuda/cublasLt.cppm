inline constexpr unsigned long long CUBLASLT_NUMERICAL_IMPL_FLAGS_ACCUMULATOR_16F = (0x01ull << 8);
inline constexpr unsigned long long CUBLASLT_NUMERICAL_IMPL_FLAGS_ACCUMULATOR_32F = (0x02ull << 8);
inline constexpr unsigned long long CUBLASLT_NUMERICAL_IMPL_FLAGS_ACCUMULATOR_64F = (0x04ull << 8);
