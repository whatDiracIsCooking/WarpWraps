inline constexpr unsigned long long CUBLASLT_NUMERICAL_IMPL_FLAGS_INPUT_TF32 = (0x04ull << 16);
inline constexpr unsigned long long CUBLASLT_NUMERICAL_IMPL_FLAGS_INPUT_32F = (0x08ull << 16);
inline constexpr unsigned long long CUBLASLT_NUMERICAL_IMPL_FLAGS_INPUT_64F = (0x10ull << 16);
inline constexpr unsigned long long CUBLASLT_NUMERICAL_IMPL_FLAGS_INPUT_8I = (0x20ull << 16);
inline constexpr unsigned long long CUBLASLT_NUMERICAL_IMPL_FLAGS_INPUT_8F_E4M3 = (0x40ull << 16);
inline constexpr unsigned long long CUBLASLT_NUMERICAL_IMPL_FLAGS_INPUT_8F_E5M2 = (0x80ull << 16);
inline constexpr unsigned long long CUBLASLT_NUMERICAL_IMPL_FLAGS_OP_INPUT_TYPE_MASK =
    (0xffull << 16);

inline constexpr unsigned long long CUBLASLT_NUMERICAL_IMPL_FLAGS_GAUSSIAN = (0x01ull << 32);

